# Copy to .env.local and fill in. Never commit .env.local.

# Canonical public origin used for links in emails, QR codes, and auth
# redirects. Use http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full database access — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places (business search) ---
GOOGLE_PLACES_API_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Observability (optional; both no-op when unset) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source-map upload at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
